# Normalise line endings to LF in the repo; checkout as-is on all platforms
* text=auto eol=lf

# Shell scripts must always be LF (bash breaks on CRLF)
*.sh text eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf

# Binaries — no line-ending conversion
*.exe binary
*.zip binary
*.tar.gz binary
